# Première initialisation uniquement. Aucun mot de passe par défaut n'existe.
PILOTEO_ADMIN_USERNAME=admin
PILOTEO_ADMIN_PASSWORD=REMPLACER-PAR-UN-MOT-DE-PASSE-LONG
PILOTEO_ADMIN_CONSULTANT_ID=SMR
PILOTEO_ADMIN_NAME=Administrateur Pilotéo

# 0 pour un test local HTTP. Mettre 1 en production derrière HTTPS.
PILOTEO_FORCE_HTTPS=0
PILOTEO_SESSION_HOURS=12
PILOTEO_BACKUP_RETENTION=30
PILOTEO_DATA_DIR=/data
PILOTEO_BACKUP_DIR=/backups
